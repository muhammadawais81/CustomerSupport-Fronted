# See https://help.github.com/articles/ignoring-files/

# ─── Dependencies ───
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Next.js ───
/.next/
/out/
/build
/dist

# ─── Environment (never commit secrets) ───
.env
.env.*
!.env.example

# ─── Testing & coverage ───
/coverage
*.lcov

# ─── Debug logs ───
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# ─── Vercel / deploy ───
.vercel

# ─── TypeScript ───
*.tsbuildinfo
next-env.d.ts

# ─── Turbo / cache ───
.turbo
.cache
.eslintcache

# ─── OS files ───
.DS_Store
Thumbs.db
Desktop.ini

# ─── Editor / IDE (local settings only) ───
.idea/
*.swp
*.swo
*~

# Optional: uncomment to ignore local VS Code / Cursor settings
# .vscode/
# .cursor/

# ─── Certificates / keys ───
*.pem
*.key
*.p12
